{
  "name": "storefront-lens",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @lens/web dev",
    "dev:worker": "pnpm --filter @lens/worker dev",
    "dev:mcp": "pnpm --filter @lens/mcp dev",
    "migrate": "pnpm --filter @lens/core migrate",
    "seed": "pnpm --filter @lens/core seed",
    "test": "pnpm --filter @lens/core test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @lens/web build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "pnpm --filter @lens/core doctor"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
