# ── Database ─────────────────────────────────────────────────────────────
# Supabase → Project → Connect → "Transaction pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Using the local Postgres profile instead? Use:
# DATABASE_URL=postgres://lens:lens@db:5432/lens

# ── Public URLs (what you configure in Cloudflare Tunnel) ────────────────
PUBLIC_URL=https://lens.example.com
PUBLIC_MCP_URL=https://mcp.example.com/mcp

# ── MCP ──────────────────────────────────────────────────────────────────
# Random secret, at least 24 characters. Generate one with:  openssl rand -hex 32
MCP_TOKEN=

# ── Cloudflare Tunnel (only for `--profile tunnel`) ─────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Schedule time zone for the daily sync ────────────────────────────────
TZ=Africa/Cairo

# ── Optional: extra password prompt on the web UI (in addition to Access) ─
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ── Optional tuning ───────────────────────────────────────────────────────
# WORKER_CONCURRENCY=2          # jobs the worker runs at once
# DATABASE_POOL_SIZE=10         # database connections per container
